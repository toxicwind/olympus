  "$schema": "https://app.kappa.ai/config.json",
  "model": "freeinference/deepseek-v4-flash",
  "default_agent": "code",
  "autoupdate": true,
  "share": "disabled",
  "username": "toxic",
  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/node_modules/**",
      "**/target/**",
      "**/build/**",
      "**/dist/**",
      "**/.venv/**",
      "**/__pycache__/**"
    ]
  },
  "formatter": {
    "prettier": {
      "disabled": false,
      "command": [
        "npx",
        "--no-install",
        "prettier",
        "--write",
        "$FILE"
      ],
      "extensions": [
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".json",
        ".css",
        ".md",
        ".yaml",
        ".yml"
      ]
    },
    "gofmt": {
      "disabled": false,
      "command": [
        "gofmt",
        "-w",
        "$FILE"
      ],
      "extensions": [
        ".go"
      ]
    },
    "rustfmt": {
      "disabled": false,
      "command": [
        "rustfmt",
        "$FILE"
      ],
      "extensions": [
        ".rs"
      ]
    }
  },
  "lsp": {
    "typescript-language-server": {
      "command": [
        "npx",
        "--no-install",
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx"
      ],
      "initialization": {
        "preferences": {
          "includeCompletionsForModuleExports": true
        }
      }
    },
    "pyright": {
      "command": [
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py"
      ]
    },
    "gopls": {
      "command": [
        "gopls"
      ],
      "extensions": [
        ".go"
      ]
    },
    "rust-analyzer": {
      "command": [
        "rust-analyzer"
      ],
      "extensions": [
        ".rs"
      ]
    }
  },
  "mcp": {
    "timeout": {
      "startup": 30000,
      "request": 60000
    },
    "servers": {
      "filesystem": {
        "type": "local",
        "command": [
          "node",
          "/home/toxic/.npm/_npx/a3241bba59c344f5/node_modules/@modelcontextprotocol/server-filesystem/dist/index.js",
          "/home/toxic"
        ],
        "enabled": true,
        "timeout": 30000
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "keep": {
      "tokens": 20000
    },
    "buffer": 4000
  },
  "skills": {
    "paths": [
      "/home/toxic/pens/estate/grasp-hub/skills",
      "~/.config/kappa/skills",
      "~/.claude/skills"
    ],
    "urls": []
  },
  "instructions": [
    "~/.config/kappa/AGENTS.md"
  ],
  "permission": {
    "*": {
      "*": "allow"
    },
    "edit": "allow",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "pitchfork *": "allow",
      "head *": "allow",
      "grep *": "allow",
      "ss *": "allow",
      "curl *": "allow",
      "which *": "allow",
      "pacman *": "allow",
      "fd *": "allow",
      "cat *": "allow",
      "git -C *": "allow",
      "find *": "allow",
      "echo *": "allow",
      "python3 *": "allow",
      "file *": "allow",
      "kappa *": "allow",
      "sed *": "allow",
      "tail *": "allow",
      "sqlite3 *": "allow",
      "strings *": "allow",
      "tau *": "allow"
    },
    "webfetch": "allow",
    "websearch": "ask",
    "read": {
      "*": "allow"
    },
    "filesystem_*": "allow",
    "filesystem_list_directory": {
      "*": "allow"
    },
    "thresher_call_tool_read": {
      "*": "allow"
    },
    "ffs_ffs_find": {
      "*": "allow"
    },
    "ffs_ffs_grep": {
      "*": "allow"
    },
    "ffs_ffs_read": {
      "*": "allow"
    },
    "thresher_retrieve_tools": {
      "*": "allow"
    },
    "filesystem_get_file_info": {
      "*": "allow"
    },
    "ffs_ffs_map": {
      "*": "allow"
    },
    "filesystem_read_text_file": {
      "*": "allow"
    },
    "external_directory": {
      "/home/toxic/pens/barn/corral/delendai/packages/core/src/lib/project/*": "allow",
      "/home/toxic/pens/olympus/products/kappa/kappa-code/*": "allow"
    },
    "ffs_ffs_multi_grep": {
      "*": "allow"
    }
  },
  "small_model": "freeinference/qwen3.6-35b",
  "snapshot": true,
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 2000,
      "max_height": 2000,
      "max_base64_bytes": 5242880
    }
  },
  "shell": "/bin/bash",
  "references": {},
  "agent": {
    "general": {
      "model": "freeinference/qwen3.6-35b"
    },
    "explore": {
      "model": "freeinference/qwen3.6-35b"
    },
    "code": {
      "model": "freeinference/qwen3.6-35b"
    },
    "plan": {
      "model": "freeinference/qwen3.6-35b"
    },
    "subagent": {
      "model": "freeinference/qwen3.6-35b"
    }
  },
  "plugin": [
    "@kappacode/kappa-indexing"
  ],
  "indexing": {
    "enabled": true,
    "roots": [
      "/home/toxic/pens",
      "/home/toxic/pens/estate"
    ],
    "provider": "openai-compatible",
    "openai-compatible": {
      "baseUrl": "https://freeinference.org/v1",
      "apiKey": "{env:FREEINFERENCE_API_KEY}"
    },
    "model": "bge-m3",
    "vectorStore": "qdrant",
    "qdrant": {
      "url": "http://127.0.0.1:25133"
    },
    "searchMinScore": 0.23,
    "searchMaxResults": 433,
    "embeddingBatchSize": 30,
    "scannerMaxBatchRetries": 1
  }
}
