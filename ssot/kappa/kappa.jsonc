{
  "provider": {
    "freeinference": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "FreeInference (HarvardMadSys Lab)",
      "options": {
        "baseURL": "https://freeinference.org/v1",
        "apiKey": "{env:FREEINFERENCE_API_KEY}",
        "maxConcurrency": 2,
        "unlimitedRetryOn429": true
      },
      "http": {
        "fingerprint": "honest"
      },
      "models": {
        "glm-5.3-flash": {
          "name": "GLM-5.3 Flash",
          "cost": {
            "input": 0.3,
            "output": 1,
            "cache_read": 0.06,
            "cache_write": 0.3
          },
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        },
        "minimax-m3": {
          "name": "MiniMax M3",
          "cost": {
            "input": 0.5,
            "output": 2,
            "cache_read": 0.3,
            "cache_write": 0.5
          },
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        },
        "qwen3.6-35b": {
          "name": "Qwen3.6 35B",
          "cost": {
            "input": 0.08,
            "output": 0.28,
            "cache_read": 0.01,
            "cache_write": 0.08
          },
          "limit": {
            "context": 262144,
            "output": 8192
          }
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (high speed)",
          "cost": {
            "input": 0.44,
            "output": 1.32,
            "cache_read": 0.014,
            "cache_write": 0.44
          },
          "limit": {
            "context": 1000000,
            "output": 393216
          }
        }
      }
    },
    "rhodochrosite": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Rhodochrosite (estate multi-provider gateway :25193)",
      "options": {
        "baseURL": "http://127.0.0.1:25193/v1",
        "apiKey": "{env:RHODOCHROSITE_API_KEY}"
      },
      "models": {
        "estate/free": {
          "name": "Rhodochrosite · estate/free (zero-cost cloud strategy)",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "estate/auto": {
          "name": "Rhodochrosite · estate/auto (Elo + health smart router)",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "estate/fast": {
          "name": "Rhodochrosite · estate/fast (lowest-latency cloud race)",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "estate/code": {
          "name": "Rhodochrosite · estate/code (coding specialist route)",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "estate/reasoning": {
          "name": "Rhodochrosite · estate/reasoning (deep reasoning route)",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "qwen3.6-35b": {
          "name": "Rhodochrosite · Qwen3.6 35B",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "deepseek-v4-flash": {
          "name": "Rhodochrosite · DeepSeek V4 Flash",
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        },
        "glm-5.3-flash": {
          "name": "Rhodochrosite · GLM-5.3 Flash",
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        },
        "minimax-m3": {
          "name": "Rhodochrosite · MiniMax M3",
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        }
      }
    },
    "nim": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM via rhodochrosite gateway (nim-proxy :8000 retired 2026-10-09 — see mimetite src/data.ts; :25193 = rhodochrosite)",
      "options": {
        "baseURL": "http://127.0.0.1:25193/v1",
        "apiKey": "{env:RHODOCHROSITE_API_KEY}",
        "timeout": false
      },
      "models": {
        "z-ai/glm-5.3-flash": {
          "name": "GLM-5.3 Flash MAX",
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "options": {
            "temperature": 0.6,
            "top_p": 0.95
          }
        },
        "nvidia/nemotron-3-super-120b-a12b": {
          "name": "Super 120B MAX",
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "options": {
            "temperature": 0.6,
            "top_p": 0.95
          }
        }
      }
    },
    "atria": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Atria (Atria-Dawn · 512K context)",
      "options": {
        "baseURL": "https://api.atria-asi.ai/v1",
        "apiKey": "{env:ATRIA_API_KEY}"
      },
      "models": {
        "Atria-Dawn": {
          "name": "Atria-Dawn",
          "limit": {
            "context": 512000,
            "output": 8192
          }
        }
      }
    },
    "agele": {
      "npm": "@ai-sdk/openai-compatible",
