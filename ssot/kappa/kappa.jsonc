{
  "$schema": "https://app.kilo.ai/config.json",
  "indexing": { "enabled": true },
  "snapshot": false,
  "plugin": [
    "/home/toxic/pens/olympus/products/kappa/extensions/lambda-bridge/plugin.ts",
    "/home/toxic/pens/olympus/products/kappa/extensions/hephaistos-commands/plugin.ts",
    "/home/toxic/pens/geode/products/azurite/mcp/server.ts"
  ],
  "mcp": {
    // ═══════════════════════════════════════════════════════════════════
    // THRESHER-ONLY DOCTRINE (2026-10-27, AGENTS.md): every MCP client —
    // kappa, tau, zed — points ONLY at the thresher gateway (:25127). DO NOT add
    // per-product stdio entries here. New MCP servers register in
    // pens/barn/products/thresher/mcp_config.json (mcpServers ARRAY) and
    // federate through the mesh gateway. A direct entry here is a doctrine
    // violation and WILL be removed by audit. The tool registry lock
    // (~/.tau/agent/mcp.json.lock + rule) enforces the same for tau.
    // ═══════════════════════════════════════════════════════════════════
    "gateway": { "type": "remote", "url": "http://127.0.0.1:25127/mcp", "enabled": true }
  },
  "skills": {
    "enableSkillCommands": true,
    "customDirectories": [
      "/home/toxic/pens/geode/products/azurite/skills",
      "/home/toxic/pens/geode/products/azurite/managed-skills",
      "/home/toxic/pens/geode/products/azurite/private-skills"
    ]
  },
  "permission": {
    "read": {
      "*": "allow"
    },
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "semantic_search": "allow",
    "kappa_memory_save": "allow",
    "kappa_memory_recall": "allow",
    "lsp": "allow",
    "skill": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "question": "allow",
    "gateway_call_tool_read": {
      "*": "allow"
    },
    "*": {
      "*": "allow"
    }
  },
  "provider": {
    // freeinference via the estate PRIMARY ENTRYPOINT rhodochrosite :25193
    // (keyed lanes, 429 rotation, per-model strikes). Key via {file:} — the
    // only token-legal form in config ({env:} is rejected outside trusted
    // scope, and the keyring file must never be committed).
    "freeinference": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "FreeInference (via rhodochrosite)",
      "options": {
        "baseURL": "http://127.0.0.1:25193/v1",
        "apiKey": "{file:/home/toxic/.tau/router.key}",
        "timeout": false
      },
      "models": {
        "qwen3.6-35b": {
          "name": "Qwen3.6 35B (chat/tools)",
          "id": "qwen3.6-35b",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 262144, "output": 8192 },
          "options": { "temperature": 0.6 }
        },
        "qwen3.6-35b-vision": {
          "name": "Qwen3.6 35B (vision)",
          "id": "qwen3.6-35b",
          "attachment": true,
          "modalities": { "input": ["text", "image", "video"], "output": ["text"] },
          "limit": { "context": 262144, "output": 8192 },
          "options": { "temperature": 0.6 }
        },
        "qwen3.6-35b-structured": {
          "name": "Qwen3.6 35B (structured/json)",
          "id": "qwen3.6-35b",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 262144, "output": 8192 },
          "options": { "temperature": 0.2, "response_format": { "type": "json_object" } }
        },
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash", "limit": { "context": 1000000, "output": 8192 }, "options": { "temperature": 0.6 } },
        "glm-5.3-flash": { "name": "GLM-5.3 Flash", "limit": { "context": 1000000, "output": 8192 }, "options": { "temperature": 0.6 } },
        "minimax-m3": { "name": "MiniMax M3", "limit": { "context": 1000000, "output": 8192 }, "options": { "temperature": 0.6 } },
        "diffusiongemma": { "name": "DiffusionGemma", "limit": { "context": 262144, "output": 8192 }, "options": { "temperature": 0.6 } }
      }
    },
    // bge-m3 embeddings keep the DIRECT freeinference lane (AGENTS.md §5.1:
    // default embedding lane; the router does not proxy embeddings).
    "freeinference-direct": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "FreeInference Direct (embeddings)",
      "options": {
        "baseURL": "https://freeinference.org/v1",
        "apiKey": "{file:/home/toxic/.tau/freeinference.key}",
        "timeout": false
      },
      "models": {
        "bge-m3": {
          "name": "BGE-M3 (embeddings)",
          "id": "bge-m3",
          "limit": { "context": 8192, "output": 1 },
          "options": { "temperature": 0 }
        }
      }
    },
    // NVIDIA NIM — same 429-aware router entrypoint, nvidia-prefixed wire ids.
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM (via rhodochrosite)",
      "options": {
        "baseURL": "http://127.0.0.1:25193/v1",
        "apiKey": "{file:/home/toxic/.tau/router.key}",
        "timeout": false
      },
      "models": {
        "nemotron-3.5-lightning": {
          "name": "Nemotron 3.5 Lightning 30B-A3B",
          "id": "nvidia/nemotron-3.5-lightning-30b-a3b",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 256000, "output": 8192 },
          "options": { "temperature": 0.6 }
        },
        "nemotron-3-super": {
          "name": "Nemotron 3 Super 120B-A12B",
          "id": "nvidia/nemotron-3-super-120b-a12b",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 500000, "output": 8192 },
          "options": { "temperature": 0.6 }
        },
        "nemotron-3-ultra": {
          "name": "Nemotron 3 Ultra 550B-A55B",
          "id": "nvidia/nemotron-3-ultra-550b-a55b",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 1000000, "output": 8192 },
          "options": { "temperature": 0.6 }
        },
        "nemotron-3-nano-omni": {
          "name": "Nemotron 3 Nano Omni 30B-A3B (reasoning)",
          "id": "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 256000, "output": 8192 },
          "options": { "temperature": 0.6 }
        },
        "glm-5.3": {
          "name": "GLM-5.3 (NIM lane)",
          "id": "z-ai/glm-5.3",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 200000, "output": 8192 },
          "options": { "temperature": 0.6 }
        },
        "gpt-oss-20b": {
          "name": "GPT-OSS 20B (NIM lane)",
          "id": "openai/gpt-oss-20b",
          "tool_call": true,
          "limit": { "context": 128000, "output": 8192 },
          "options": { "temperature": 0.6 }
        }
      }
    }
  }
}

